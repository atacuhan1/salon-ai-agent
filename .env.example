# Copy to .env.local and fill in values. The app runs with in-memory mocks
# when these are left empty, so local development does not require secrets.

# OpenAI. En ucuz varsayılan: gpt-4o-mini, kısa cevap, az geçmiş.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=220
OPENAI_HISTORY_LIMIT=4

# Google Calendar service account (shared). Per-salon calendar ID is set in the panel.
# Share each salon calendar with GOOGLE_CLIENT_EMAIL (Make changes to events).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional demo/single-tenant fallback when a salon has no googleCalendarId:
GOOGLE_CALENDAR_ID=

# Supabase (conversation history). See README for the SQL table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API (production: strong random values; fail-closed without these)
# Generate: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Production webhook callback URL (Meta App → WhatsApp → Configuration):
# https://salon-ai-agent-sens6.vercel.app/api/webhook
# Per-salon routing: panel → WhatsApp phone_number_id (not only the env above).

# Always Europe/Istanbul (UTC+3). Do not change unless you know why.
SALON_TIMEZONE=Europe/Istanbul
LOG_LEVEL=info

# Owner dashboard — Postgres. SQLite yok; Vercel disk’i kalıcı değil.
# Yerel: docker compose up -d   veya   npm run db:up
DATABASE_URL=postgresql://salon:salon@127.0.0.1:5432/salon
# Vercel/Neon pooler kullanıyorsanız migrate için doğrudan (unpooled) URL:
# DIRECT_URL=postgresql://salon:salon@127.0.0.1:5432/salon
# Required in production (openssl rand -base64 32). No weak defaults.
AUTH_SECRET=
