# Copy to .env.local and fill in values. The app runs with in-memory mocks
# when these are left empty, so local development does not require secrets.

# OpenAI. En ucuz varsayılan: gpt-4o-mini, kısa cevap, az geçmiş.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=220
OPENAI_HISTORY_LIMIT=4

# Google Calendar (service account). Share the calendar with GOOGLE_CLIENT_EMAIL.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Supabase (conversation history). See README for the SQL table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API (set strong random values in production; no defaults)
WHATSAPP_VERIFY_TOKEN=replace-me-with-a-long-random-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Always Europe/Istanbul (UTC+3). Do not change unless you know why.
SALON_TIMEZONE=Europe/Istanbul
LOG_LEVEL=info

# Owner dashboard — Postgres. SQLite yok; Vercel disk’i kalıcı değil.
# Yerel: docker compose up -d   veya   npm run db:up
DATABASE_URL=postgresql://salon:salon@127.0.0.1:5432/salon
# Vercel/Neon pooler kullanıyorsanız migrate için doğrudan (unpooled) URL:
# DIRECT_URL=postgresql://salon:salon@127.0.0.1:5432/salon
# Required in production (openssl rand -base64 32). No weak defaults.
AUTH_SECRET=
